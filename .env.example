# MercadoLibre — https://developers.mercadolibre.cl/  (site MLC)
MELI_CLIENT_ID=
MELI_CLIENT_SECRET=
# El formulario de MELI exige HTTPS y valida que el dominio resuelva: localhost es rechazado.
# Debe ser identico, caracter por caracter, al redirect_uri de la peticion de autorizacion.
MELI_REDIRECT_URI=https://acabreirav.github.io/PropInvest/oauth/callback
# access token dura 6 h; refresh token 6 meses y es de un solo uso
MELI_REFRESH_TOKEN=

# CMF — apikey gratuita bajo registro
CMF_APIKEY=

# Identidad del crawler. Debe ser real y resoluble.
USER_AGENT="FlujoCero-ResearchBot/1.0 (+https://TU-DOMINIO.cl/bot; contacto@TU-DOMINIO.cl)"

# Outreach (opcional, fase 2). Nunca envía sin aprobación humana del lote.
SMTP_HOST=
SMTP_USER=
SMTP_PASS=
OUTREACH_FROM_NAME=
OUTREACH_DAILY_CAP=40

# Datos de pago (opcional, ver docs/05-decisiones.md D-005)
DATABAM_API_KEY=
DATAINMOBILIARIA_API_KEY=
